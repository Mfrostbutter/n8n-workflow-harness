# Copy to .env and fill. NEVER commit .env.
#
# .mcp.json reads N8N_API_URL / N8N_API_KEY from the PROCESS environment, not
# from this file on disk. Export them before launching Claude Code:
#
#   set -a; . ./.env; set +a; claude
#
# Without them the n8n-docs server still works (node schemas, validation,
# templates). The managed `n8n` server needs them to reach an instance.

# The instance you are building against. Point at dev.
N8N_API_URL=
N8N_API_KEY=

# Per-environment values kept for reference. Copy a pair into the active
# variables above when you switch targets. The toolkit also reads these
# directly: ./scripts/doctor.sh staging
N8N_API_URL_DEV=
N8N_API_KEY_DEV=

N8N_API_URL_STAGING=
N8N_API_KEY_STAGING=

# Prod is intentionally blank. Promotion goes through your agreed release path,
# not an ad-hoc API write from a build session.
N8N_API_URL_PROD=
N8N_API_KEY_PROD=

# Only if the instance sits behind Cloudflare Access (Zero Trust).
# N8N_CF_CLIENT_ID=
# N8N_CF_CLIENT_SECRET=
