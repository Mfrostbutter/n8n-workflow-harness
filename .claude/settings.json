{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(node scripts/:*)",
      "Bash(./scripts/doctor.sh:*)",
      "Bash(./scripts/health-check.sh:*)",
      "Bash(./scripts/drift-check.sh:*)",
      "Bash(./scripts/export-all.sh:*)",
      "Bash(./scripts/validate.sh:*)",
      "Bash(node --version)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "mcp__n8n-docs__search_nodes",
      "mcp__n8n-docs__get_node",
      "mcp__n8n-docs__validate_node",
      "mcp__n8n-docs__validate_workflow",
      "mcp__n8n-docs__search_templates",
      "mcp__n8n-docs__get_template",
      "mcp__n8n-docs__tools_documentation",
      "Bash(./scripts/lint-workflow.sh:*)",
      "Bash(./scripts/wf-diff.sh:*)",
      "Bash(./scripts/node-inventory.sh:*)",
      "Bash(./scripts/gen-agent-configs.sh:*)",
      "mcp__n8n-official__get_workflow_sdk_reference",
      "mcp__n8n-official__get_workflow_best_practices",
      "mcp__n8n-official__search_nodes",
      "mcp__n8n-official__get_node_types",
      "mcp__n8n-official__validate_workflow",
      "mcp__n8n-official__validate_node_config",
      "mcp__n8n-official__get_workflow_details",
      "mcp__n8n-official__search_workflows",
      "mcp__n8n-official__get_workflow_history",
      "mcp__n8n-official__get_workflow_versions_diff"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "mcp__n8n__n8n_delete_workflow",
      "mcp__n8n-official__delete_data_table",
      "mcp__n8n-official__delete_data_table_column",
      "mcp__n8n-official__delete_agent"
    ]
  },
  "enabledMcpjsonServers": [
    "n8n-docs",
    "n8n"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__n8n__n8n_(create_workflow|update_partial_workflow|update_full_workflow|delete_workflow|autofix_workflow|deploy_template|manage_credentials|manage_folders)",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-n8n-write.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/guard-pre-tool.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
