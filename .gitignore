# Secrets
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*

# Credential exports never belong in the repo
credentials*.json
*-credentials.json
exports/

# Credential ids are instance-local. The secret map (names and references) is committed.
deploy/creds.*.json

# Local Claude Code overrides
.claude/settings.local.json

# Scratch
.tmp/
*.log
*.jsonl
.DS_Store
node_modules/

# Offline install artifacts from scripts/vendor-mcp.sh. Large. Commit
# deliberately only for air-gapped delivery.
vendor/

# Windows: gen-agent-configs copies .agents/skills/ over the tracked symlinks in
# .claude/skills/. The copies' contents are never committed; the symlinks are.
.claude/skills/*/**
