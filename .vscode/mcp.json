{
  "inputs": [
    {
      "type": "promptString",
      "id": "N8N_API_URL",
      "description": "N8N_API_URL (leave blank if not used)"
    },
    {
      "type": "promptString",
      "id": "N8N_API_KEY",
      "description": "N8N_API_KEY (leave blank if not used)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "N8N_CF_CLIENT_ID",
      "description": "N8N_CF_CLIENT_ID (leave blank if not used)"
    },
    {
      "type": "promptString",
      "id": "N8N_CF_CLIENT_SECRET",
      "description": "N8N_CF_CLIENT_SECRET (leave blank if not used)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "N8N_MCP_ACCESS_TOKEN",
      "description": "N8N_MCP_ACCESS_TOKEN (leave blank if not used)",
      "password": true
    }
  ],
  "servers": {
    "n8n-docs": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/mcp-server.mjs"
      ],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_MCP_TELEMETRY_DISABLED": "true"
      }
    },
    "n8n": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/mcp-server.mjs"
      ],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "${input:N8N_API_URL}",
        "N8N_API_KEY": "${input:N8N_API_KEY}",
        "N8N_CF_CLIENT_ID": "${input:N8N_CF_CLIENT_ID}",
        "N8N_CF_CLIENT_SECRET": "${input:N8N_CF_CLIENT_SECRET}",
        "N8N_MCP_TELEMETRY_DISABLED": "true"
      }
    },
    "n8n-official": {
      "type": "http",
      "url": "${input:N8N_API_URL}/mcp-server/http",
      "headers": {
        "Authorization": "Bearer ${input:N8N_MCP_ACCESS_TOKEN}"
      }
    }
  }
}
